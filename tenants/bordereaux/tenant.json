    "layout_a_drift": {"policy_number": "Policy No", "insured_name": "Insured", "line_of_business": "Class", "inception_date": "Inception", "expiry_date": "Expiry", "currency": "Ccy", "gross_premium": "GWP", "commission_amount": "Brokerage", "risk_country": "Country", "risk_postcode": "Postcode"},
    "layout_b": {"policy_number": "Policy Reference", "insured_name": "Name of Insured", "line_of_business": "Line of Business", "inception_date": "Risk Inception", "expiry_date": "Risk Expiry", "currency": "Currency", "gross_premium": "Premium (GBP)", "commission_amount": "Commission Amt", "risk_country": "Risk Country", "risk_postcode": "Risk Post Code"},
    "layout_c": {"policy_number": "Cert Number", "insured_name": "Assured", "line_of_business": "Cover", "inception_date": "Start", "expiry_date": "End", "currency": "Cur", "gross_premium": "Written Premium", "commission_amount": "Comm", "risk_country": "Territory", "risk_postcode": "Zip"},
    "claims_a": {"claim_reference": "Claim Ref", "policy_number": "Policy No", "loss_date": "Date of Loss", "paid_amount": "Paid", "outstanding_amount": "Outstanding", "cause_of_loss": "Cause", "currency": "Ccy"},
    "claims_b": {"claim_reference": "Claim Reference", "policy_number": "Policy Reference", "loss_date": "Loss Date", "paid_amount": "Paid to Date", "outstanding_amount": "Reserve", "cause_of_loss": "Peril", "currency": "Currency"},
    "claims_c": {"claim_reference": "Claim No", "policy_number": "Cert Number", "loss_date": "DOL", "paid_amount": "Paid Amt", "outstanding_amount": "O/S", "cause_of_loss": "Loss Type", "currency": "Cur"}
  },

  "projections": {
    "premium_rows": {
      "table": "premium_bordereau_line",
      "target_contract": "bricksurance_exchange.premium_bordereau_line",
      "source_system_code": "COVERHOLDER_BDX"
    },
    "claims_rows": {
