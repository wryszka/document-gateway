{
  "_comment": "Bordereaux tenant config. The tenant is CONFIG, not code — it declares document families, dictionary extensions, layouts (deterministic anchors), templates, and typed projections. The base engine (extraction, reconciliation, graph capture, trust loop) is tenant-agnostic and reads this. Months are DERIVED from as_of at generation time so a reset rolls the book to today (Principle 11).",

  "tenant": "bordereaux",
  "label": "Bordereaux",
  "subtitle": "Delegated authority · premium & claims",

  "families": {
    "premium_bordereau": {"kind": "tabular", "file_token": "premium", "fields": "premium", "lander": "premium", "projection": "premium_rows", "node_label": "PremiumBordereauLine"},
    "claims_bordereau": {"kind": "tabular", "file_token": "claims", "fields": "claims", "lander": "claims", "projection": "claims_rows", "node_label": "ClaimBordereauLine"}
  },

  "dictionary_extensions": {
    "_comment": "Entity types / attributes / allowed relations added to the shared dictionary for this tenant.",
    "entities": {
      "Coverholder": {"description": "A delegated-authority agent (MGA/broker) authorised to bind and administer business on the carrier's behalf, and to report it via bordereaux.", "attributes": ["name", "coverholder_reference", "binder_reference", "country_code"]},
      "PremiumBordereauLine": {"description": "One reported premium line on a monthly premium bordereau.", "attributes": ["policy_number", "insured_name", "line_of_business", "inception_date", "expiry_date", "currency", "gross_premium", "commission_amount", "risk_country", "risk_postcode", "reporting_month"]},
      "ClaimBordereauLine": {"description": "One reported claim line on a monthly claims bordereau.", "attributes": ["claim_reference", "policy_number", "loss_date", "paid_amount", "outstanding_amount", "cause_of_loss", "currency", "reporting_month"]},
      "ReportingPeriod": {"description": "The calendar month a bordereau reports on (completeness is measured over these).", "attributes": ["reporting_month"]}
    },
    "relationships": {
      "SUBMITTED_BY": {"source": "PremiumBordereauLine", "target": "Coverholder", "description": "The coverholder that reported the premium line."},
      "REPORTS_POLICY": {"source": "PremiumBordereauLine", "target": "Policy", "description": "The policy the premium line reports on."},
      "FOR_PERIOD": {"source": "PremiumBordereauLine", "target": "ReportingPeriod", "description": "The reporting month the line belongs to."},
      "CLAIM_SUBMITTED_BY": {"source": "ClaimBordereauLine", "target": "Coverholder", "description": "The coverholder that reported the claim line."},
      "CLAIM_ON_POLICY": {"source": "ClaimBordereauLine", "target": "Policy", "description": "The policy the claim reports against."}
    }
  },

  "logical_fields": {
    "premium": ["policy_number", "insured_name", "line_of_business", "inception_date", "expiry_date", "currency", "gross_premium", "commission_amount", "risk_country", "risk_postcode"],
    "claims": ["claim_reference", "policy_number", "loss_date", "paid_amount", "outstanding_amount", "cause_of_loss", "currency"]
  },

  "layouts": {
    "_comment": "logical_field -> the exact header label this layout uses. Premium and claims layouts.",
